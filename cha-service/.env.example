# Shared secret the tracker presents as `Authorization: Bearer <token>`.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=

# REDCap. The API URL is shared across CPCQC projects; the token is per-project.
REDCAP_API_URL=https://redcap.vumc.org/api/
REDCAP_SOAR_TOKEN=

# Not needed until those programs are implemented.
REDCAP_SPARK_TOKEN=
REDCAP_NEST_TOKEN=
REDCAP_TTT_HOSPITAL_TOKEN=
REDCAP_TTT_PATIENT_TOKEN=

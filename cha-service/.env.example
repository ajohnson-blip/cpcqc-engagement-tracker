# Copy to .env beside run_assessment.py and fill in. Never commit .env.
# Anything already set in the environment takes precedence over this file.

# --- Output: required ---
# Where each night's file is written. Local disk or a mounted network share.
# Must already exist; the script will not create it.
OUTPUT_DIR=

# --- Delivery to the tracker: optional ---
# Leave DELIVERY_URL empty and nothing leaves CHA. Both values come from CPCQC.
DELIVERY_URL=
DELIVERY_TOKEN=

# --- REDCap ---
REDCAP_API_URL=https://redcap.vumc.org/api/
REDCAP_SOAR_TOKEN=
# Seconds per REDCap call.
REDCAP_TIMEOUT=90

# Not used until those programs are implemented.
# REDCAP_SPARK_TOKEN=
# REDCAP_NEST_TOKEN=
# REDCAP_TTT_HOSPITAL_TOKEN=
# REDCAP_TTT_PATIENT_TOKEN=
# REDCAP_TTT_DYADIC_TOKEN=

# --- Scope: optional ---
# Defaults to every implemented program whose token is set.
# PROGRAMS=SOAR
# Defaults to the current year, plus the previous one in January and February.
# PROGRAM_YEARS=2026

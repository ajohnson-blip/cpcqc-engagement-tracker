# Application
NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:3001

# Database
DATABASE_URL=postgres://cpcqc:cpcqc@localhost:5432/cpcqc_tracker

# Auth
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-different-long-random-string
# Access token = 8h (a full workday); refresh token = 45-day IDLE timeout,
# rotated and reset on every use, so active users are not signed out.
JWT_ACCESS_TTL_SECONDS=28800
JWT_REFRESH_TTL_DAYS=45
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Email (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=engagement@qi.cpcqc.org

# CORS
CORS_ORIGIN=http://localhost:3000

# REDCap (Vanderbilt) integration — per-project API tokens are SECRETS.
# Leave blank locally; set the real values as Render environment variables.
REDCAP_API_URL=https://redcap.vumc.org/api/
REDCAP_SPARK_TOKEN=
REDCAP_NEST_TOKEN=
REDCAP_SOAR_TOKEN=
# Turning the Tide spans two projects (patient token = PHI).
REDCAP_TTT_HOSPITAL_TOKEN=
REDCAP_TTT_PATIENT_TOKEN=
# Denver Health enters its TtT patient forms in the CHoSEN Dyadic project.
# Optional: when set, the TtT sync folds DH's eligible Dyadic maternal forms into
# DH's patient-form counts (also PHI — rows are only counted). The DAG is DH's
# Data Access Group *in the Dyadic project*; defaults to 'denver_health'.
REDCAP_TTT_DYADIC_TOKEN=
REDCAP_TTT_DYADIC_DH_DAG=denver_health
# Only if CHoSEN Dyadic is hosted on a different REDCap instance than the
# CPCQC projects. Leave blank to reuse REDCAP_API_URL.
REDCAP_TTT_DYADIC_API_URL=

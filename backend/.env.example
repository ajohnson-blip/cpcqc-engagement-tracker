# Application
NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:3001

# Database
DATABASE_URL=postgres://cpcqc:cpcqc@localhost:5432/cpcqc_tracker

# Auth
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-different-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Email (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=engagement@qi.cpcqc.org

# CORS
CORS_ORIGIN=http://localhost:3000

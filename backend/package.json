{
  "name": "cpcqc-engagement-tracker-backend",
  "version": "0.1.0",
  "description": "Backend for the CPCQC hospital engagement tracker (qi.cpcqc.org).",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:import-templates": "tsx scripts/import-task-templates.ts",
    "db:enroll": "tsx scripts/auto-enroll.ts",
    "db:import-pm-data": "tsx scripts/import-pm-engagement-data.ts",
    "db:backfill-task-instances": "tsx scripts/backfill-task-instances.ts",
    "db:recompute-stages": "tsx scripts/recompute-stages.ts",
    "redcap:spark-sync": "tsx scripts/redcap-spark-sync.ts",
    "redcap:nest-sync": "tsx scripts/redcap-nest-sync.ts",
    "redcap:soar-sync": "tsx scripts/redcap-soar-sync.ts",
    "redcap:ttt-sync": "tsx scripts/redcap-ttt-sync.ts",
    "create-cpcqc-staff": "tsx scripts/create-cpcqc-staff.ts",
    "create-user": "tsx scripts/create-user.ts",
    "create-hospital-user": "tsx scripts/create-hospital-user.ts",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.15.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
